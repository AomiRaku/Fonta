{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FontFox",
  "version": "1012.0.0",
  "identifier": "dev.fontfox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FontFox",
        "width": 1180,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true,
        "center": true,
        "backgroundColor": "#F7F7F8",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "decorations": false,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": { "../LICENSE": "./", "../NOTICE": "./", "../THIRD_PARTY_LICENSES.txt": "./", "../langBuild/*.ini": "lang/" },
    "shortDescription": "FontFox font manager.",
    "publisher": "Raku Inkyetta",
    "copyright": "Copyright (c) 2026 羽梦千景 Raku Inkyetta",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "windows": {
      "minimumWebview2Version": "110.0.1587.0",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon_ins.ico",
        "uninstallerIcon": "icons/icon_unis.ico",
        "languages": ["SimpChinese", "English"],
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "template": "nsis/installer.nsi",
        "sidebarImage": "../docs/img/install.bmp"
      }
    }
  }
}
